generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  RECRUITER
  TPO_ADMIN
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  INTERN_PLUS_FTE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFERED
  REJECTED
  ACCEPTED
  DECLINED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// 1. Core User & Authentication
model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String?
  name          String
  role          Role              @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  student       StudentProfile?
  recruiter     RecruiterProfile?
  tpo           TpoProfile?

  @@index([role])
  @@index([createdAt])
}

// 2. College & TPO Management
model College {
  id          String             @id @default(cuid())
  name        String             @unique // e.g. "Delhi Technological University"
  code        String?            @unique // e.g. "DTU"
  domain      String?            // e.g. "dtu.ac.in" (for college email domain validation)
  city        String?
  state       String?
  logoUrl     String?

  tpos        TpoProfile[]
  students    StudentProfile[]
  jobs        Job[]
  offers      Offer[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([name])
}

model TpoProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId   String
  college     College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  designation String?            // e.g. "Head, Training & Placement Cell"

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([collegeId])
}

// 3. Student Profile
model StudentProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId         String
  college           College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  enrollmentNumber  String          @unique
  branch            String          // e.g. "Computer Science & Engineering"
  batchYear         Int             // e.g. 2026
  cgpa              Float           // e.g. 8.75
  tenthMarks        Float?          // Percentage or CGPA
  twelfthMarks      Float?          // Percentage or CGPA
  resumeUrl         String?
  skills            String[]        @default([])
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  isVerified        Boolean         @default(false)

  applications      Application[]
  offers            Offer[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([collegeId])
  @@index([branch, batchYear])
  @@index([cgpa])
  @@index([isVerified])
}

// 4. Company & Recruiter Profile
model Company {
  id          String             @id @default(cuid())
  name        String             @unique
  website     String?
  logoUrl     String?
  industry    String?
  location    String?
  description String?            @db.Text
  isVerified  Boolean            @default(false)

  recruiters  RecruiterProfile[]
  jobs        Job[]
  offers      Offer[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isVerified])
}

model RecruiterProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation String?            // e.g. "University Relations Lead"

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([companyId])
}

// 5. Job Drive & Eligibility
model Job {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collegeId       String
  college         College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  title           String            // e.g. "Software Engineer - Full Stack"
  description     String            @db.Text
  type            JobType           @default(FULL_TIME)
  status          JobStatus         @default(PENDING_APPROVAL)
  location        String            // "Bangalore (Hybrid)", "Remote", etc.
  salaryPackage   String            // e.g. "12 - 16 LPA" or "₹40,000/month"
  
  minCgpa         Float             @default(0.0)
  allowedBranches String[]          @default([]) // ["CSE", "ECE", "IT"]
  eligibleBatches Int[]             @default([]) // [2026, 2027]
  deadline        DateTime

  applications    Application[]
  offers          Offer[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Composite indexes for student job feeds and recruiter listings
  @@index([collegeId])
  @@index([companyId])
  @@index([status, deadline])
  @@index([type])
  @@index([createdAt])
}

// 6. Application Pipeline
model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status      ApplicationStatus @default(APPLIED)
  resumeUrl   String?           // Snapshot of resume at time of applying
  notes       String?           @db.Text // Internal recruiter evaluation notes
  
  offer       Offer?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Guaranteed prevention of duplicate applications at DB engine level
  @@unique([jobId, studentId])
  
  // Indexes for applicant pipeline filtering and student tracking history
  @@index([jobId, status])
  @@index([studentId, status])
  @@index([createdAt])
}

// 7. Formal Offer Letter & Placement Contract
model Offer {
  id            String          @id @default(cuid())
  applicationId String          @unique
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  studentId     String
  student       StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  collegeId     String
  college       College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  designation   String          // e.g. "Associate Software Engineer"
  salaryPackage String          // e.g. "14.5 LPA"
  location      String          // e.g. "Bangalore (Hybrid)"
  joiningDate   DateTime?
  letterUrl     String?         // Link to official PDF Offer Letter
  notes         String?         @db.Text

  status        OfferStatus     @default(PENDING)
  expiresAt     DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([collegeId, status])
  @@index([companyId, status])
  @@index([studentId, status])
  @@index([createdAt])
}
